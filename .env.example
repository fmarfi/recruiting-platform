# Copy to .env (git-ignored). Never commit real secrets.
# docker-compose.yml (local containers)
POSTGRES_DB=recruiting
POSTGRES_USER=recruiting
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Application (read by application.yml). Export these or use your IDE run config.
DB_URL=jdbc:postgresql://localhost:5432/recruiting
DB_USER=recruiting
DB_PASSWORD=change-me-locally
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@recruiting.local
APP_BASE_URL=http://localhost:8080

# Pilot only: all of DB_*, MAIL_*, APP_BASE_URL are mandatory (no defaults) - set them in the host's secret store.
# Later (Phase 2): LLM provider API keys, e.g. AI_API_KEY=
