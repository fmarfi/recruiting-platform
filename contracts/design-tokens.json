  "badge": {
    "$comment": "A badge is always dot + text label (never colour alone). Size sm for lists and cards, md default, lg for record headers.",
    "shape": "pill",
    "sizes": {
      "sm": {
        "height": 22,
        "paddingX": 8,
        "fontSize": "0.75rem"
      },
      "md": {
        "height": 24,
        "paddingX": 10,
        "fontSize": "0.8rem"
      },
      "lg": {
        "height": 28,
        "paddingX": 12,
        "fontSize": "0.86rem"
      }
    },
    "fontWeight": 500,
    "dotSize": 6
  },
  "spacing": {
    "unit": 4,
    "scale": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "7": 28,
      "8": 40
