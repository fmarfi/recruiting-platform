    "gutter": {
      "desktop": 32,
      "phone": 16
    },
    "sidebarWidth": 240,
    "contentMaxWidth": 1360,
    "touchTargetMin": 44,
    "$comment": "Card padding 20px 24px desktop, 16px phone. List row padding 14px 20px desktop, 12px 16px phone."
  },
  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 8,
    "sheet": 12,
    "pill": 999
  },
  "shadow": {
    "pop": {
      "light": "0 8px 24px rgba(15,26,43,.10), 0 1px 3px rgba(15,26,43,.06)",
      "dark": "0 8px 24px rgba(15,26,43,.10), 0 1px 3px rgba(15,26,43,.06)"
    }
  },
  "typography": {
    "$comment": "Turkish needs dotted/dotless i and the letters Ğ Ş Ç Ö Ü: load the latin-ext subset of the web fonts.",
    "fontSans": "\"Inter\", \"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "fontMono": "\"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Consolas, monospace",
    "base": {
      "desktop": "15px",
      "phone": "15px",
      "lineHeight": 1.55
    },
    "scale": {
      "h1": {
        "desktop": "1.65rem",
        "phone": "1.4rem",
        "weight": 600
      },
      "h2": {
        "size": "1.1rem",
        "weight": 600
      },
      "h3": {
        "size": "1rem",
        "weight": 600
      },
      "body": {
        "size": "1rem",
        "weight": 400
      },
      "small": {
        "size": "0.875rem",
        "weight": 500
      },
      "caption": {
        "size": "0.8125rem",
        "weight": 400
      },
      "eyebrow": {
        "size": "0.75rem",
        "weight": 600,
        "transform": "uppercase",
        "letterSpacing": "0.06em",
        "family": "sans"
      }
    }
  },
  "breakpoints": {
    "phone": 719,
    "tablet": 960,
    "laptop": 1100
