<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.recruiting</groupId>
  <artifactId>recruiting-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>recruiting-platform</name>
  <description>AI recruiting platform: CRM (Phase 1) and AI tool (Phase 2), Spring Modulith monolith</description>

  <modules>
    <module>contracts</module>
    <module>security</module>
    <module>privacy</module>
    <module>crm-accounts</module>
    <module>crm-pipeline</module>
    <module>ai</module>
    <module>platform-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <spring-modulith.version>2.1.1</spring-modulith.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency><groupId>com.recruiting</groupId><artifactId>contracts</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.recruiting</groupId><artifactId>security</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.recruiting</groupId><artifactId>privacy</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.recruiting</groupId><artifactId>crm-accounts</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.recruiting</groupId><artifactId>crm-pipeline</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.recruiting</groupId><artifactId>ai</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <!-- Integration tests (*IT, Testcontainers, needs Docker): mvn verify -Pintegration -->
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
