{
  "name": "recruiting-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts",
    "postinstall": "npm run gen:api",
    "dev": "vite",
    "mock": "prism mock -p 4010 -h 127.0.0.1 ../contracts/openapi.yaml",
    "typecheck": "npm run gen:api && tsc --noEmit",
    "test": "vitest run",
    "build": "npm run gen:api && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "i18next": "26.4.7",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.20",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
